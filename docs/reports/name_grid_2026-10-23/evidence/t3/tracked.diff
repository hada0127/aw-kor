+def _name_compose_payload(syl_to_code):
+    """_part2_name_compose 가 쓰는 영역별 바이트(이름 → bytes)."""
+    import gen_jamo_assets as jamo
+    import part2_name_compose_blob as blob
+    payload = {
+        'jamo_tiles': jamo.jamo_tiles(jamo.OUT_GLYPHS),
+        'nc_dense': jamo.dense_table(syl_to_code),
+        'nc_image': blob.CODE + bytes(blob.IMAGE_MAX - len(blob.CODE)),
+        's1_press': _abs_tramp(0, blob.entry('nc_tramp_press')) + bytes.fromhex('c046'),
+        's2_confirm': _abs_tramp(0, blob.entry('nc_tramp_confirm')),
+        's3_backspace': _abs_tramp(0, blob.entry('nc_tramp_backspace'), 0x34B20E),
+        'd1_display': bytes.fromhex('004b1847') + struct.pack('<I', blob.entry('nc_tramp_display')),
+        'p1_alloc': struct.pack('<I', blob.entry('nc_alloc')),
+    }
+    regions = NAME_COMPOSE_REGIONS
+    for name, data in payload.items():
+        if len(data) != regions[name][1] - regions[name][0]:
+            raise ValueError(f'name-compose payload {name} size {len(data)} mismatch')
+    return payload
+

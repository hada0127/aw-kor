+def _name_compose_mismatches(rom, expected, names):
+    """names 영역의 기대 바이트 불일치 + A3 min/mask/start · end 리터럴 4곳 · 이웃 포인터 검사."""
+    bad = [name for name, start, end in NAME_COMPOSE_WRITES
+           if name in names and bytes(rom[start:end]) != expected[name]]
+    hook = PART2_HOOK_A3_FILE
+    if (bytes(rom[hook + 0x80:hook + 0x84]) != PART2_HOOK_A3[0x80:0x84]
+            or bytes(rom[hook + 0x90:hook + 0x94]) != PART2_HOOK_A3[0x90:0x94]
+            or struct.unpack_from('<I', rom, hook + PART2_HOOK_A3_TABLE_START_OFF)[0] != P.NEW_TBL_RT):
+        bad.append('a3_min_mask_start')
+    table_end = P.NEW_TBL_RT + sum(NAME_COMPOSE_TABLE_ENTRIES) * 6
+    for literal in NAME_COMPOSE_END_LITERALS:
+        if struct.unpack_from('<I', rom, literal)[0] != table_end:
+            bad.append(f'end_literal_0x{literal:X}')
+    for start, value in NAME_COMPOSE_KEEP:
+        if bytes(rom[start:start + 4]) != value:
+            bad.append(f'keep_0x{start:X}')
+    return bad
+

+def _name_compose_expected(syl_to_code, codes):
+    """영역 이름 → 최종 기대 바이트(앞 단계 A3 max·표 tail 포함)."""
+    import gen_jamo_assets as jamo
+    sylmap = json.load(open(SYLMAP_2350, encoding='utf-8'))['map']
+    sylmap['자']['top'] = 1274
+    expected = _name_compose_payload(syl_to_code)
+    expected['a3_table_tail'] = jamo.jamo_table_entries(sylmap, codes)
+    expected['a3_max'] = struct.pack('<I', max(*syl_to_code.values(), *codes.values()))
+    return expected
+

+def _name_compose_inputs(orig, syl_to_code):
+    """자모 코드·코드 이미지를 읽고 검증한다(캐시 없음). 실패 시 ValueError."""
+    import gen_jamo_assets as jamo
+    import part2_name_compose_blob as blob
+    from build_korean2350 import extend_pool
+    codes = jamo.load_jamo_codes(jamo.OUT_CODES, SYLCODE)
+    values = set(codes.values())
+    if values & set(syl_to_code.values()):
+        raise ValueError('jamo codes overlap the 2350 syllable codes')
+    outside = sorted(values - set(extend_pool(orig)))
+    if outside:
+        raise ValueError('jamo codes outside the original reserved pool: '
+                         + ', '.join(f'0x{c:04X}' for c in outside))
+    with open(jamo.OUT_CODES, 'rb') as f:
+        if hashlib.sha256(f.read()).hexdigest() != blob.SOURCE_SHA['data/jamo_to_code_40.json']:
+            raise ValueError('jamo code JSON differs from the one compiled into the name-compose image')
+    blob.verify_code()
+    stale = blob.check_sources()
+    if stale:
+        raise ValueError('name-compose image is stale (tools/name_compose/build_image.py): '
+                         + ', '.join(stale))
+    image = NAME_COMPOSE_REGIONS
+    if ((blob.IMAGE_RT, blob.DENSE_RT) != (0x08000000 + image['nc_image'][0], 0x08000000 + image['nc_dense'][0])
+            or blob.DENSE_BYTES != image['nc_dense'][1] - image['nc_dense'][0]
+            or len(blob.CODE) > min(blob.IMAGE_MAX, image['nc_image'][1] - image['nc_image'][0])):
+        raise ValueError(f'name-compose image layout/size invalid ({len(blob.CODE)}B)')
+    return codes
+
+
+def _name_compose_a3_max(rom, syl_to_code, orig):
+    """A3 hook max 리터럴(F30304)을 2350+자모 최대 코드로 넓힌다. 실패 시 ValueError·rom 불변."""
+    codes = _name_compose_inputs(orig, syl_to_code)
+    # 생성 단계: hook 이 막 기록된 PART2_HOOK_A3 그대로여야 한다(max 0xE2A7, 표 end 0, min/mask).
+    if bytes(rom[PART2_HOOK_A3_FILE:PART2_HOOK_A3_FILE + len(PART2_HOOK_A3)]) != PART2_HOOK_A3:
+        raise ValueError('A3 hook differs from the generated payload before the name-compose max')
+    new_max = max(*syl_to_code.values(), *codes.values())
+    struct.pack_into('<I', rom, PART2_HOOK_A3_FILE + PART2_HOOK_A3_MAX_OFF, new_max)
+    # 회귀 가드(2026-06-16): A3는 [min,max] 밖 코드를 한글로 보지 않는다. 기록된 값을 다시 읽는다.
+    written = struct.unpack_from('<I', rom, PART2_HOOK_A3_FILE + PART2_HOOK_A3_MAX_OFF)[0]
+    if written < max(*syl_to_code.values(), *codes.values()):
+        raise AssertionError(f'A3 hook max code 0x{written:X} < 실제 최대 예약코드')
+    return written
+
+
+def _name_compose_table_tail(rom, new_tbl, orig_tbl, sylmap, syl_to_code, orig):
+    """2350 표 뒤에 붙일 자모 40 엔트리(240B)를 돌려준다. new_tbl·rom 은 바꾸지 않는다."""
+    import gen_jamo_assets as jamo
+    codes = _name_compose_inputs(orig, syl_to_code)
+    base, syllables, _ = NAME_COMPOSE_TABLE_ENTRIES
+    if sylmap['자']['top'] != 1274:
+        raise ValueError('자 top is not the private tile 1274')
+    expected = bytearray(orig_tbl)
+    for s in sorted(sylmap):
+        code = syl_to_code[s]
+        expected += bytes([code >> 8, code & 0xFF]) + struct.pack(
+            '<HH', sylmap[s]['top'] | 0x8000, sylmap[s]['bot'] | 0x8000)
+    if len(orig_tbl) != base * 6 or len(sylmap) != syllables or bytes(new_tbl) != bytes(expected):
+        raise ValueError('A3 table is not the generated 536+2350 stage before the jamo tail')
+    tail_start, tail_end = NAME_COMPOSE_REGIONS['a3_table_tail']
+    if P.NEW_TBL_FILE + len(new_tbl) != tail_start or any(rom[tail_start:tail_end]):
+        raise ValueError('A3 table jamo tail region is not the empty slot after the 2350 entries')
+    tail = jamo.jamo_table_entries(sylmap, codes)
+    if len(tail) != tail_end - tail_start:
+        raise ValueError('A3 table jamo tail size mismatch')
+    return tail
+

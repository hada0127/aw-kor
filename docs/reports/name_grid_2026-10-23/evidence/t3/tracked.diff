+def _verify_part2_name_compose(rom, orig):
+    """최종 payload 필수 대조. 불일치 영역이 하나라도 있으면 AssertionError."""
+    syl_to_code = {s: int(c, 16) for s, c in json.load(open(SYLCODE, encoding='utf-8')).items()}
+    expected = _name_compose_expected(syl_to_code, _name_compose_inputs(orig, syl_to_code))
+    bad = _name_compose_mismatches(rom, expected, {name for name, _, _ in NAME_COMPOSE_WRITES})
+    if bad:
+        raise AssertionError('name-compose final payload mismatch: ' + ', '.join(bad))
+    import part2_name_compose_blob as blob
+    return {'code_bytes': len(blob.CODE), 'code_sha256': blob.CODE_SHA,
+            'a3_max': f'0x{struct.unpack("<I", expected["a3_max"])[0]:04X}',
+            'table_end': f'0x{P.NEW_TBL_RT + sum(NAME_COMPOSE_TABLE_ENTRIES) * 6:08X}'}
+
+
+def _part2_name_compose(rom, orig):
+    """자모 타일·nc_dense·코드 이미지와 S1~S3·D1·P1 훅을 쓴다(PLAN-v5 T3).
+
+    A3 max·표 tail·end 리터럴은 앞 단계(_name_compose_a3_max·_name_compose_table_tail)가 이미
+    썼어야 한다. 사전조건을 모두 확인한 뒤에만 쓴다 — 실패하면 ValueError, rom 불변.
+    """
+    syl_to_code = {s: int(c, 16) for s, c in json.load(open(SYLCODE, encoding='utf-8')).items()}
+    expected = _name_compose_expected(syl_to_code, _name_compose_inputs(orig, syl_to_code))
+    regions = NAME_COMPOSE_REGIONS
+    errors = [f'{name}: earlier stage mismatch' for name in
+              _name_compose_mismatches(rom, expected, {'a3_table_tail', 'a3_max'})]
+    for name, original in NAME_COMPOSE_SITES:
+        start, end = regions[name]
+        if bytes(orig[start:end]) != original:
+            errors.append(f'{name}: original ROM differs from expect')
+        if bytes(rom[start:end]) != original:
+            errors.append(f'{name}: site already changed')
+    for start, value in NAME_COMPOSE_KEEP:
+        if bytes(orig[start:start + 4]) != value:
+            errors.append(f'keep pointer 0x{start:X}: original ROM differs from expect')
+    if any(rom[regions['jamo_tiles'][0]:regions['jamo_tiles'][1]]):
+        errors.append('jamo_tiles: region not empty')
+    # nc_dense·이미지와 그 사이 틈(F75748..F75800)까지 비어 있어야 한다.
+    if any(rom[regions['nc_dense'][0]:regions['nc_image'][1]]):
+        errors.append('F70000..F77800 not empty')
+    if any(rom[0xF09F20:0xF09F40]) or not any(rom[0xF09F40:0xF09F60]):
+        errors.append('tile 1273 blank / 1274 private 자 changed')
+    if errors:
+        raise ValueError('name-compose preconditions failed: ' + '; '.join(errors))
+    for name, start, end in NAME_COMPOSE_WRITES:
+        if name not in ('a3_table_tail', 'a3_max'):
+            rom[start:end] = expected[name]
+    return _verify_part2_name_compose(rom, orig)
+
